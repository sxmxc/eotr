code = "shader_type canvas_item;
render_mode blend_add, unshaded;

uniform float Transparency : hint_range(0.0, 1.0);
uniform vec2 Speed = vec2(1.000000, 0.000000);
uniform sampler2D basic_texture : source_color, repeat_enable;



void fragment() {
// Input:11
	vec4 n_out11p0 = COLOR;


// FloatParameter:10
	float n_out10p0 = Transparency;


// Input:6
	float n_out6p0 = TIME;


// Vector2Parameter:8
	vec2 n_out8p0 = Speed;


// VectorOp:7
	vec2 n_out7p0 = vec2(n_out6p0) * n_out8p0;


// UVFunc:5
	vec2 n_in5p1 = vec2(1.00000, 1.00000);
	vec2 n_out5p0 = n_out7p0 * n_in5p1 + UV;


	vec4 n_out4p0;
// Texture2D:4
	n_out4p0 = texture(basic_texture, n_out5p0);


// SmoothStep:9
	float n_in9p1 = 1.00000;
	float n_out9p0 = smoothstep(n_out10p0, n_in9p1, n_out4p0.x);


// VectorOp:12
	vec3 n_out12p0 = vec3(n_out11p0.xyz) * vec3(n_out9p0);


// Output:0
	COLOR.rgb = n_out12p0;


}
"
