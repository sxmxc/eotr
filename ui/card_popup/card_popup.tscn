[gd_scene format=3 uid="uid://dxrlbs4ir0thk"]

[ext_resource type="Script" path="res://ui/card_popup/card_popup.gd" id="script"]
[ext_resource type="Theme" path="res://resources/themes/rift_ui.tres" id="theme"]

[node name="CardPopup" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Background" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme_type_variation = &"ModalScrim"

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Surface" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(540, 0)
layout_mode = 2

[node name="Padding" type="MarginContainer" parent="Center/Surface"]
layout_mode = 2
theme_type_variation = &"ModalContentMargin"

[node name="Content" type="VBoxContainer" parent="Center/Surface/Padding"]
layout_mode = 2
theme_type_variation = &"ContentStack"

[node name="PopupCard" type="CenterContainer" parent="Center/Surface/Padding/Content"]
unique_name_in_owner = true
layout_mode = 2

[node name="CardDescription" type="RichTextLabel" parent="Center/Surface/Padding/Content"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"WorldMessageText"
bbcode_enabled = true
fit_content = true
scroll_active = false
horizontal_alignment = 1

[node name="Actions" type="HBoxContainer" parent="Center/Surface/Padding/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ChoiceRow"
alignment = 1

[node name="CloseButton" type="Button" parent="Center/Surface/Padding/Content/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Back"

[node name="ConfirmButton" type="Button" parent="Center/Surface/Padding/Content/Actions"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Take card"

[connection signal="pressed" from="Center/Surface/Padding/Content/Actions/CloseButton" to="." method="hide_popup"]
[connection signal="gui_input" from="." to="." method="_on_gui_input"]
