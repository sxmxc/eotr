[node name="RichTextLabel" type="RichTextLabel" parent="BattleTutorial/TabContainer/HowToBattle" unique_id=700617296]
layout_mode = 0
offset_left = 51.0
offset_top = 320.0
offset_right = 1026.0
offset_bottom = 656.0
bbcode_enabled = true
text = "Objective: Defeat every hostile. Destroying the Obelisk stops its attacks and summons; surviving enemies still need to be defeated.
Turn start: Draw cards, reset energy, and clear block. Class and relic effects can add bonuses.
Your turn: Play cards, then end your turn. Right click cancels aiming without spending energy.
Collapse: Watch the round counter and highlighted edge. Collapse kills anything on removed tiles; move inward.
Fog: Reveal enemies to see their health and plans. Unknown rows show enemies still hidden."
fit_content = true

