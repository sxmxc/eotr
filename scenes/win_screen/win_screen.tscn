[node name="Message" type="Label" parent="UILayer/Panel/MarginContainer/Panel/VBoxContainer/MarginContainer/VBoxContainer" unique_id=2108282481]
unique_name_in_owner = true
custom_minimum_size = Vector2(1320, 447)
layout_mode = 2
text = "The last obelisk crumbles into stardust, its scream lost in the collapsing void. 
With the final echo silenced, the Rift begins to close — not with fury, but relief. 
You’ve severed the anchors that tethered this fractured dimension to chaos. 
The Rift’s song grows quiet.

The Void Spectre — that twisted echo of forgotten timelines — lies broken, 
unraveling into fading threads of possibility. 
You have not only survived the echoes...

You have rewritten them."
autowrap_mode = 2
script = ExtResource("5_1gpf6")
Auto_Start = true
Interval = 0.1
Interval_Variation = 0.0
metadata/_custom_type_script = "uid://i3w1a3c08jt1"

