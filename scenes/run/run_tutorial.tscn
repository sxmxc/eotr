[node name="RichTextLabel" type="RichTextLabel" parent="RunTutorial/ScrollContainer" unique_id=277373548]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = true
text = "Welcome to the Run Map, your route through the Rift. Quick primer:

[b]Objective[/b] - Each act has 15 floors. Defeat its boss to advance; finish all three acts to complete the run.

[b]Nodes[/b] - Monsters/Elites = battles, Treasure = free relic, Rest = heal 30% max HP, Shop = buy cards/relics, Boss = advance the run.

[b]Health[/b] - Carries between battles; if it hits 0 the run ends. Rest nodes and some rewards restore health.

[b]Currencies[/b] - Gold buys cards. Resources buy relics/services. Resource tiles in battle fuel relic costs.

[b]Deck[/b] - Grow it via rewards and shops; trimming keeps draws consistent.

[b]Map Legend[/b] - Open the encounter legend to read icons. Choose paths carefully; once you commit, upstream nodes lock."
fit_content = true

[connection signal="pressed" from="RunTutorial/Button" to="." method="_on_button_pressed"]
